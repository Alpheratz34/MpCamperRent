# ============================================
# MpCamperRent - Variables de entorno (servidor)
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a `.env` (en server/.env)
# 2. Rellena las claves con tus datos reales
# 3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
#
# RECUERDA: las claves PÚBLICAS (pk_*, client-id de PayPal) van en
# js/config.js, no aquí. Aquí solo van las claves SECRETAS.
# ============================================

# --- Servidor ---
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://mpcamperrent.com

# --- Token de admin (para acceder a /admin.html) ---
# Genera uno aleatorio largo, p.ej. con: openssl rand -hex 32
ADMIN_TOKEN=cambia-esto-por-un-token-aleatorio-largo

# --- Stripe (pagos con tarjeta) ---
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
# Usa las claves de TEST para desarrollo (empiezan por sk_test_)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# --- PayPal ---
# Obtén tus credenciales en: https://developer.paypal.com/dashboard/applications
# Usa Sandbox para desarrollo
PAYPAL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_MODE=sandbox
# Cambia a 'live' en producción:
# PAYPAL_MODE=live
